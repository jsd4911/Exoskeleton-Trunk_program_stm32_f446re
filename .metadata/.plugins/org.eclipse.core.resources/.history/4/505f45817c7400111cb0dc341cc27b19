/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  /* USER CODE BEGIN 2 */

  // 1. 等待感測器完全通電
    HAL_Delay(500);

    // 2. 啟動硬體診斷
    Check_BNO085_Hardware();

    // 3. FDCAN 接收過濾器配置 (Classic Mode 傳統接收)
    FDCAN_FilterTypeDef sFilterConfig;
    sFilterConfig.IdType = FDCAN_STANDARD_ID;
    sFilterConfig.FilterIndex = 0;
    sFilterConfig.FilterType = FDCAN_FILTER_MASK;
    sFilterConfig.FilterConfig = FDCAN_FILTER_TO_RXFIFO0;
    sFilterConfig.FilterID1 = 0x000;
    sFilterConfig.FilterID2 = 0x000; // 接受所有來自馬達的 ID

    if (HAL_FDCAN_ConfigFilter(&hfdcan1, &sFilterConfig) != HAL_OK) {
        Error_Handler();
    }
    if (HAL_FDCAN_ConfigFilter(&hfdcan2, &sFilterConfig) != HAL_OK) {
        Error_Handler();
    }

    // 4. 啟動雙路 FDCAN 模組
    HAL_FDCAN_Start(&hfdcan1);
    HAL_FDCAN_Start(&hfdcan2);

    // 5. 啟用 FDCAN FIFO0 接收中斷 (用以取得馬達真實角度)
    HAL_FDCAN_ActivateNotification(&hfdcan1, FDCAN_IT_RX_FIFO0_NEW_DATA, 0);
    HAL_FDCAN_ActivateNotification(&hfdcan2, FDCAN_IT_RX_FIFO0_NEW_DATA, 0);

    // 6. 啟動並初始化馬達 (送出 Enable 指令)
    printf("🚀 傳送馬達開啟指令至 FDCAN1 & FDCAN2...\r\n");
    AK10_9_EnableMotor(&hfdcan1, 0x01);
    HAL_Delay(50);
    AK10_9_EnableMotor(&hfdcan2, 0x01);
    HAL_Delay(100);
    printf("馬達初始化完畢！進入單板超低延遲控制迴圈...\r\n");

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  // 🌟 限制主迴圈運作頻率為 50Hz (20ms)，配合感測器與馬達發送頻率
	      if (HAL_GetTick() - last_loop_tick >= 20) {
	          last_loop_tick = HAL_GetTick();
	          heartbeat++;

	          // ================= 🧠 1. 讀取感測器角度 =================
	          current_pitch = Read_BNO085_Pitch();

	          // 防突然暴衝保護
	          if (isnan(current_pitch) || current_pitch < -180.0f || current_pitch > 180.0f) {
	              current_pitch = previous_pitch;
	          }
	          float delta_pitch = current_pitch - previous_pitch;
	          previous_pitch = current_pitch;

	          // ================= 🛡️ 2. 扭力狀態機邏輯運算 =================
	          float target_Kp = 0.0f;
	          float target_tau = 0.0f;

	          if (current_pitch < 15.0f && current_pitch > -15.0f) {
	              current_state = STATE_IDLE;
	          } else if (current_pitch > 45.0f && fabs(delta_pitch) < 0.2f) {
	              current_state = STATE_HOLDING;
	          } else if (delta_pitch > 0.1f) {
	              current_state = STATE_BENDING_DOWN;
	          } else if (delta_pitch < -0.1f) {
	              current_state = STATE_RETURNING_UP;
	          }

	          switch (current_state) {
	              case STATE_IDLE:
	                  target_Kp = 15.0f;
	                  target_tau = 0.0f;
	                  break;
	              case STATE_BENDING_DOWN:
	                  target_Kp = 5.0f;
	                  target_tau = 0.5f * 9.8f * 0.175f * sinf(current_pitch * 3.14159f / 180.0f) * 0.8f;
	                  break;
	              case STATE_HOLDING:
	                  target_Kp = 25.0f;
	                  target_tau = 0.5f * 9.8f * 0.175f * sinf(current_pitch * 3.14159f / 180.0f);
	                  break;
	              case STATE_RETURNING_UP:
	                  target_Kp = 15.0f;
	                  target_tau = 0.5f * 9.8f * 0.175f * sinf(current_pitch * 3.14159f / 180.0f) + 3.0f;
	                  break;
	          }

	          // 平滑漸變過渡，防止硬體撞擊
	          float smooth_factor = 0.5f;
	          current_Kp += (target_Kp - current_Kp) * smooth_factor;
	          tau_ff_A += (target_tau - tau_ff_A) * smooth_factor;

	          // ================= 📐 3. 雙軸逆向運動學反解 (IK) =================
	          float motor_cmd_A, motor_cmd_B;
	          float L1_len = 0.20f;
	          float L2_len = 0.075f;
	          float base_radius = 0.24f;

	          if (is_ik_init == 0) {
	              float cos_phi_zero = (L1_len*L1_len + L2_len*L2_len - base_radius*base_radius) / (2.0f * L1_len * L2_len);
	              if(cos_phi_zero > 1.0f) cos_phi_zero = 1.0f;
	              if(cos_phi_zero < -1.0f) cos_phi_zero = -1.0f;
	              theta_B_zero = 3.14159f - acosf(cos_phi_zero);
	              is_ik_init = 1;
	          }

	          if (current_state == STATE_IDLE) {
	              motor_cmd_A = motorA_offset;
	              motor_cmd_B = motorB_offset;
	          } else {
	              // A 馬達命令
	              motor_cmd_A = -(current_pitch * 3.14159f / 180.0f) + motorA_offset;

	              // 伸長距離計算
	              float elongation = (current_pitch / 90.0f) * 0.03f;
	              if (elongation < 0.0f) elongation = 0.0f;
	              float current_radius = base_radius + elongation;

	              float cos_phi = (L1_len*L1_len + L2_len*L2_len - current_radius*current_radius) / (2.0f * L1_len * L2_len);
	              if(cos_phi > 1.0f) cos_phi = 1.0f;
	              if(cos_phi < -1.0f) cos_phi = -1.0f;

	              // B 馬達命令 (反向)
	              motor_cmd_B = -((3.14159f - acosf(cos_phi)) - theta_B_zero) + motorB_offset;
	          }

	          if (is_cmd_init == 0) {
	              smooth_cmd_A = motorA_offset;
	              smooth_cmd_B = motorB_offset;
	              is_cmd_init = 1;
	          }

	          // 指令平滑輸出
	          smooth_cmd_A += (motor_cmd_A - smooth_cmd_A) * 0.80f;
	          smooth_cmd_B += (motor_cmd_B - smooth_cmd_B) * 0.10f;

	          // ================= 🚀 4. 發送指令給 FDCAN1 & FDCAN2 =================
	          AK10_9_SendCommand(&hfdcan1, 0x01, smooth_cmd_A, 0.0f, current_Kp, 1.5f, tau_ff_A);
	          AK10_9_SendCommand(&hfdcan2, 0x01, smooth_cmd_B, 0.0f, current_Kp * 0.4f, 1.0f, 0.0f);

	          // ================= 🖨️ 5. 調試訊息輸出 (100ms) =================
	          if (heartbeat % 5 == 0) {
	              printf("[%s] 💓 State:%d | Pitch:%.1f | CmdA:%.2f | CmdB:%.2f | Kp:%.2f | ActA:%.2f | ActB:%.2f\r\n",
	                     (bno085_hardware_ok ? "I2C" : "SIM"),
	                     current_state, current_pitch, smooth_cmd_A, smooth_cmd_B, current_Kp,
	                     motorA_actual_pos, motorB_actual_pos);
	          }
	      }
  }
  /* USER CODE END 3 */
}
