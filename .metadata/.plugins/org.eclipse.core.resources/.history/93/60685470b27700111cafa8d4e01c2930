/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
	// 🌟 實驗：在晶片最早期，手動強行開啟 GPIOG 的硬體時脈
	  __HAL_RCC_GPIOG_CLK_ENABLE();

	  // 🌟 手動配置 PG8 (LD7) 的暫存器參數
	  GPIO_InitTypeDef GPIO_InitStructPrivate = {0};
	  GPIO_InitStructPrivate.Pin = GPIO_PIN_8;            // 指向 PG8 [cite: 1025]
	  GPIO_InitStructPrivate.Mode = GPIO_MODE_OUTPUT_PP;  // 推挽輸出
	  GPIO_InitStructPrivate.Pull = GPIO_NOPULL;
	  GPIO_InitStructPrivate.Speed = GPIO_SPEED_FREQ_LOW;
	  HAL_GPIO_Init(GPIOG, &GPIO_InitStructPrivate);

	  // 🌟 核心關鍵：根據官方手冊規定，LD7 是【低電位點亮 (Active LOW)】
	  // 寫入 GPIO_PIN_RESET (0) 才會真正點亮藍燈！
	  HAL_GPIO_WritePin(GPIOG, GPIO_PIN_8, GPIO_PIN_RESET);

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_I2C3_Init();
  SystemIsolation_Config();
  /* USER CODE BEGIN 2 */
  char boot_msg[] = "\r\n==========================================\r\n🚀 STM32N6 Exo-System Context V4 Initialized OK!\r\n==========================================\r\n";
  HAL_UART_Transmit(&huart1, (uint8_t*)boot_msg, strlen(boot_msg), HAL_MAX_DELAY);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */

  // 🌟 修正：手動在這裡宣告並初始化計數器變數
  uint32_t cycle_count = 0;
  while (1)
  {
	  // 📊 打包即時狀態字串
	  char cycle_msg[64];
	  sprintf(cycle_msg, "Exo-System Syncing... Tx Count: %lu\r\n", cycle_count++);

	  // 📡 經由 Virtual COM Port 發送回電腦
	  HAL_UART_Transmit(&huart1, (uint8_t*)cycle_msg, strlen(cycle_msg), HAL_MAX_DELAY);

	  // 🔵 讓藍燈 (LD7, PG8) 配合發送頻率翻轉狀態
	  HAL_GPIO_TogglePin(GPIOG, GPIO_PIN_8);

	  // ⏱️ 延時 1 秒 (1000ms)
	  HAL_Delay(1000);
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

