/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
	// 🌟 實驗：在晶片最早期，手動強行開啟 GPIOG 的硬體時脈
	  __HAL_RCC_GPIOG_CLK_ENABLE();

	  // 🌟 手動配置 PG8 (LD7) 的暫存器參數
	  GPIO_InitTypeDef GPIO_InitStructPrivate = {0};
	  GPIO_InitStructPrivate.Pin = GPIO_PIN_8;            // 指向 PG8 [cite: 1025]
	  GPIO_InitStructPrivate.Mode = GPIO_MODE_OUTPUT_PP;  // 推挽輸出
	  GPIO_InitStructPrivate.Pull = GPIO_NOPULL;
	  GPIO_InitStructPrivate.Speed = GPIO_SPEED_FREQ_LOW;
	  HAL_GPIO_Init(GPIOG, &GPIO_InitStructPrivate);

	  // 🌟 核心關鍵：根據官方手冊規定，LD7 是【低電位點亮 (Active LOW)】
	  // 寫入 GPIO_PIN_RESET (0) 才會真正點亮藍燈！
	  HAL_GPIO_WritePin(GPIOG, GPIO_PIN_8, GPIO_PIN_RESET);

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_I2C3_Init();
  SystemIsolation_Config();
  /* USER CODE BEGIN 2 */
  // 📡 1. 透過序列埠發送測試起跑宣告
    char boot_msg[] = "\r\n==========================================\r\n🚀 STM32N6 V4 Application initialized OK!\r\n==========================================\r\n";
    HAL_UART_Transmit(&huart1, (uint8_t*)boot_msg, strlen(boot_msg), HAL_MAX_DELAY);

    char imu_start_msg[] = "🔍 Starting BNO085 IMU Handshake Test via I2C3...\r\n";
    HAL_UART_Transmit(&huart1, (uint8_t*)imu_start_msg, strlen(imu_start_msg), HAL_MAX_DELAY);

    /* ———————— 🛠️ STEP 1: 硬體重置 BNO085 (PD6) ———————— */
    // 由於時脈已由 MX_GPIO_Init 合法開啟，這裡可以直接安全操作引腳
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_6, GPIO_PIN_RESET);
    HAL_Delay(100);
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_6, GPIO_PIN_SET);

    /* ———————— 🛠️ STEP 2: 等待中斷腳 (PB2) 被 BNO085 拉低 ———————— */
    uint32_t bno_timeout = HAL_GetTick();
    char wait_msg[] = "⏳ Waiting for BNO_INT (PB2) to go LOW...\r\n";
    HAL_UART_Transmit(&huart1, (uint8_t*)wait_msg, strlen(wait_msg), HAL_MAX_DELAY);

    // 安全監聽實體引腳電位
    while(HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_2) == GPIO_PIN_SET)
    {
        if((HAL_GetTick() - bno_timeout) > 2000)
        {
            char timeout_msg[] = "❌ Error: BNO085 Reset Timeout! INT pin stayed HIGH.\r\n";
            HAL_UART_Transmit(&huart1, (uint8_t*)timeout_msg, strlen(timeout_msg), HAL_MAX_DELAY);
            Error_Handler();
        }
    }

    /* ———————— 🛠️ STEP 3: 盲讀 SHTP 開機廣告封包標頭（雙位址相容） ———————— */
    uint8_t shtp_header[4] = {0};
    uint16_t detected_addr = (0x4A << 1);
    HAL_StatusTypeDef status;

    // 嘗試用 0x4A 進行第一次通訊
    status = HAL_I2C_Master_Receive(&hi2c3, detected_addr, shtp_header, 4, 100);
    if(status != HAL_OK)
    {
        char retry_msg[] = "⚠️ Address 0x4A no response, switching to 0x4B...\r\n";
        HAL_UART_Transmit(&huart1, (uint8_t*)retry_msg, strlen(retry_msg), HAL_MAX_DELAY);

        detected_addr = (0x4B << 1);
        status = HAL_I2C_Master_Receive(&hi2c3, detected_addr, shtp_header, 4, 100);
    }

    if(status == HAL_OK)
    {
        uint16_t packet_length = (((uint16_t)shtp_header[1] << 8) | shtp_header[0]) & 0x7FFF;

        char success_msg[128];
        sprintf(success_msg, "✅ IMU Connected successfully!\r\n🎯 Found at I2C Address: 0x%02X\r\n📦 First SHTP Packet Length: %u bytes\r\n",
                (detected_addr >> 1), packet_length);
        HAL_UART_Transmit(&huart1, (uint8_t*)success_msg, strlen(success_msg), HAL_MAX_DELAY);
    }
    else
    {
        char i2c_err_msg[128];
        sprintf(i2c_err_msg, "❌ Error: Both Failed! Return Status: %d, ErrorCode: 0x%08LU\r\n", status, hi2c3.ErrorCode);
        HAL_UART_Transmit(&huart1, (uint8_t*)i2c_err_msg, strlen(i2c_err_msg), HAL_MAX_DELAY);
        Error_Handler();
    }


  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */

  // 🌟 修正：手動在這裡宣告並初始化計數器變數
  uint32_t cycle_count = 0;
  while (1)
  {
	  // 📊 打包即時狀態字串
	  char cycle_msg[64];
	  sprintf(cycle_msg, "Exo-System Syncing... Tx Count: %lu\r\n", cycle_count++);

	  // 📡 經由 Virtual COM Port 發送回電腦
	  HAL_UART_Transmit(&huart1, (uint8_t*)cycle_msg, strlen(cycle_msg), HAL_MAX_DELAY);

	  // 🔵 讓藍燈 (LD7, PG8) 配合發送頻率翻轉狀態
	  HAL_GPIO_TogglePin(GPIOG, GPIO_PIN_8);

	  // ⏱️ 延時 1 秒 (1000ms)
	  HAL_Delay(1000);
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

