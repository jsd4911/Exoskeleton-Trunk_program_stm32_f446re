/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C3_Init();
  MX_USART1_UART_Init();
  SystemIsolation_Config();
  /* USER CODE BEGIN 2 */
  HAL_Delay(1000);
  printf("\r\n=== STM32N657X0 BNO085 姿態解算啟動 ===\r\n");

  // 0. I2C3 總線防鬼影精密掃描
  I2C3_Scan();

  // 1. 硬體重置 BNO085
  BNO085_Reset();

  // 再次防禦性偵測單一地址
  if (HAL_I2C_IsDeviceReady(&hi2c3, BNO08x_ADDR, 5, 100) == HAL_OK) {
      printf("-> BNO085 (0x4B) 連線成功！準備接收資料...\r\n");
  } else {
      printf("-> BNO085 連線失敗，啟動自動喚醒嘗試...\r\n");
  }
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    // --- 任務 A：自動喚醒/敲門機制 ---
    // 如果還沒有收到成功的數據包，每 2 秒主動向 BNO085 發送一次啟動 Rotation Vector 的指令
    if (isStreaming == 0 && (HAL_GetTick() - lastCmdTick > 2000)) {
        printf("-> 發送啟動指令給 BNO085...\r\n");
        HAL_I2C_Master_Transmit(&hi2c3, BNO08x_ADDR, setFeatureCmd, 21, 100);
        lastCmdTick = HAL_GetTick();
    }

    // --- 任務 B：中斷與低電位雙重防線讀取解算 ---
    // 只要 D7 中斷旗標觸發，或者實體 PE11 腳處於低電平（代表感測器有新資料要吐出來），就執行讀取
    if (bno_data_ready || HAL_GPIO_ReadPin(GPIOE, GPIO_PIN_11) == GPIO_PIN_RESET)
    {
        bno_data_ready = 0; // 清除軟體中斷標記
        uint8_t header[4];

        // 1. 讀取 4 位元組的 SHTP 標頭
        if (HAL_I2C_Master_Receive(&hi2c3, BNO08x_ADDR, header, 4, 100) == HAL_OK)
        {
            // 解析出整筆資料封包的長度
            uint16_t length = ((header[1] << 8) | header[0]) & 0x7FFF;
            uint8_t channel = header[2];

            if (length > 0 && length <= 512)
            {
                uint8_t shtpData[512];
                // 2. 完整讀取整個 length 長度的數據
                if (HAL_I2C_Master_Receive(&hi2c3, BNO08x_ADDR, shtpData, length, 100) == HAL_OK)
                {
                    // 判斷是否為 Rotation Vector (通道 3 且 Feature ID 為 0x05)
                    if (channel == 3 && shtpData[9] == 0x05)
                    {
                        isStreaming = 1; // 成功讀取，解除自動發送狀態

                        // 提取四元數原始 16 位元資料 (小端格式拼接)
                        int16_t i_raw = (shtpData[14] << 8) | shtpData[13];
                        int16_t j_raw = (shtpData[16] << 8) | shtpData[15];
                        int16_t k_raw = (shtpData[18] << 8) | shtpData[17];
                        int16_t r_raw = (shtpData[20] << 8) | shtpData[19];

                        // 四元數數值縮放 (14 bit Q-point = 2^14 = 16384)
                        float qI = (float)i_raw / 16384.0f;
                        float qJ = (float)j_raw / 16384.0f;
                        float qK = (float)k_raw / 16384.0f;
                        float qR = (float)r_raw / 16384.0f;

                        // 計算中間輔助變數
                        float sqI = qI * qI;
                        float sqJ = qJ * qJ;
                        float sqK = qK * qK;

                        // 高精度四元數轉歐拉角 (Roll, Pitch, Yaw)
                        roll  = atan2f(2.0f * (qR * qI + qJ * qK), 1.0f - 2.0f * (sqI + sqJ)) * (180.0f / (float)M_PI);
                        pitch = asinf(2.0f * (qR * qJ - qK * qI)) * (180.0f / (float)M_PI);
                        yaw   = atan2f(2.0f * (qR * qK + qI * qJ), 1.0f - 2.0f * (sqJ + sqK)) * (180.0f / (float)M_PI);

                        // VCP 終端機格式化角度輸出
                        printf("姿態角度 -> Roll: %6.1f | Pitch: %6.1f | Yaw: %6.1f\r\n", roll, pitch, yaw);
                    }
                }
            }
        }
    }
  }
  /* USER CODE END 3 */
}

