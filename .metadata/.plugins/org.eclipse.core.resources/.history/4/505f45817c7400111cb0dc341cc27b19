// ====================================================================
// 🌟 1. STM32N6 FDCAN 中斷接收回呼函數 (取得馬達真實角度)
// ====================================================================
void HAL_FDCAN_RxFifo0Callback(FDCAN_HandleTypeDef *hfdcan, uint32_t RxFifo0ITs)
{
  if ((RxFifo0ITs & FDCAN_IT_RX_FIFO0_NEW_DATA) != 0) {
      FDCAN_RxHeaderTypeDef RxHeader;
      uint8_t rx_data[8];

      // 從 FIFO0 取得馬達回傳訊號
      if (HAL_FDCAN_GetRxMessage(hfdcan, FDCAN_RX_FIFO0, &RxHeader, rx_data) == HAL_OK) {
          uint16_t p_int = (rx_data[1] << 8) | rx_data[2];
          float position = uint_to_float(p_int, P_MIN, P_MAX, 16);

          if (hfdcan->Instance == FDCAN1) {
              // 來自 A 軸馬達的反饋
              if (is_motorA_offset_set == 0) {
                  motorA_offset = position; // 開機當下角度記作 offset
                  is_motorA_offset_set = 1;
              }
              motorA_actual_pos = position - motorA_offset;
          }
          else if (hfdcan->Instance == FDCAN2) {
              // 來自 B 軸馬達的反饋
              if (is_motorB_offset_set == 0) {
                  motorB_offset = position; // 開機當下角度記作 offset
                  is_motorB_offset_set = 1;
              }
              motorB_actual_pos = position - motorB_offset;
          }
      }
  }
}

// ====================================================================
// 🌟 2. 針對 STM32N6 FDCAN 模組重新建構的 AK10-9 發送指令
// ====================================================================
void AK10_9_SendCommand(FDCAN_HandleTypeDef *hfdcan, uint8_t id, float p_des, float v_des, float kp, float kd, float t_ff) {
    FDCAN_TxHeaderTypeDef TxHeader;
    uint8_t tx_data[8];

    // 數值與暫存器格式映射轉換
    uint16_t p_int = float_to_uint(p_des, P_MIN, P_MAX, 16);
    uint16_t v_int = float_to_uint(v_des, V_MIN, V_MAX, 12);
    uint16_t kp_int = float_to_uint(kp, KP_MIN, KP_MAX, 12);
    uint16_t kd_int = float_to_uint(kd, KD_MIN, KD_MAX, 12);
    uint16_t t_int = float_to_uint(t_ff, T_MIN, T_MAX, 12);

    // 打包 8 節點經典 CAN 封包
    tx_data[0] = p_int >> 8;
    tx_data[1] = p_int & 0xFF;
    tx_data[2] = v_int >> 4;
    tx_data[3] = ((v_int & 0x0F) << 4) | (kp_int >> 8);
    tx_data[4] = kp_int & 0xFF;
    tx_data[5] = kd_int >> 4;
    tx_data[6] = ((kd_int & 0x0F) << 4) | (t_int >> 8);
    tx_data[7] = t_int & 0xFF;

    // STM32N6 傳統 Classic Mode 配置
    TxHeader.Identifier = id;
    TxHeader.IdType = FDCAN_STANDARD_ID;
    TxHeader.TxFrameType = FDCAN_DATA_FRAME;
    TxHeader.DataLength = FDCAN_DLC_BYTES_8;
    TxHeader.ErrorStateIndicator = FDCAN_ESI_ACTIVE;
    TxHeader.BitRateSwitch = FDCAN_BRS_OFF;
    TxHeader.FDFormat = FDCAN_CLASSIC_CAN; // 🌟 核心：設為傳統 Classic Mode 傳送
    TxHeader.TxEventFifoControl = FDCAN_NO_TX_EVENTS;
    TxHeader.MessageMarker = 0;

    // 送入 N6 Tx 發送 FIFO 隊列 (不卡死、速度極快)
    HAL_FDCAN_AddMessageToTxFifoQ(hfdcan, &TxHeader, tx_data);
}

// ====================================================================
// 🌟 3. 馬達啟用與關閉函數
// ====================================================================
void AK10_9_EnableMotor(FDCAN_HandleTypeDef *hfdcan, uint8_t id) {
    FDCAN_TxHeaderTypeDef TxHeader;
