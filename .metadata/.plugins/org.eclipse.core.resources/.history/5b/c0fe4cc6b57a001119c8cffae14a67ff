/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C4_Init();
  MX_USART1_UART_Init();

  // 🚀 【完美啟用：還原系統資源隔離配置】
  // 本專案編譯為 Secure 韌體，必須執行此設定以啟用 RIF 總線時鐘與外設權限
  SystemIsolation_Config();

  /* USER CODE BEGIN 2 */

  HAL_Delay(1000);
  printf("\r\n=== STM32N657X0 BNO085 姿態解算引擎啟動 ===\r\n");

  // 🚀 【還原 GPIO 特權與安全引腳降級配置】
  HAL_GPIO_ConfigPinAttributes(GPIOE, GPIO_PIN_13, GPIO_PIN_NSEC | GPIO_PIN_NPRIV);
  HAL_GPIO_ConfigPinAttributes(GPIOE, GPIO_PIN_14, GPIO_PIN_NSEC | GPIO_PIN_NPRIV);
  HAL_GPIO_ConfigPinAttributes(GPIOE, GPIO_PIN_11, GPIO_PIN_NSEC | GPIO_PIN_NPRIV); // EXTI11 中斷腳降級
  HAL_GPIO_ConfigPinAttributes(GPIOD, GPIO_PIN_12, GPIO_PIN_NSEC | GPIO_PIN_NPRIV); // RST 復位腳降級

  // 1. 強制重置 BNO085
  printf("[BNO085] 正在執行硬體重置...\r\n");
  HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, GPIO_PIN_RESET); // RST 拉低重置
  HAL_Delay(100);                                        // 延長至 100ms 確保完整重置
  HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, GPIO_PIN_SET);   // RST 放開
  HAL_Delay(800);                                        // 給感測器更充裕的啟動時間
  printf("[BNO085] 硬體重置與初始化完成。\r\n");

  // 2. I2C 總線精密診斷掃描
  I2C4_Scan();

  // 3. 進行地址就緒確認
  if (HAL_I2C_IsDeviceReady(&hi2c4, BNO08x_ADDR, 5, 100) == HAL_OK) {
      printf("-> BNO085 (0x4B) 連線成功！準備接收資料...\r\n");
  } else {
      printf("-> BNO085 連線失敗，請檢查實體上拉電阻與控制線！\r\n");
  }
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    // --- 任務 A：自動定時喚醒機制 (防死鎖保障) ---
    if (isStreaming == 0 && (HAL_GetTick() - lastCmdTick > 2000)) {
        printf("[BNO085] 正在發送 Rotation Vector (四元數) 訂閱指令...\r\n");
        HAL_I2C_Master_Transmit(&hi2c4, BNO08x_ADDR, setFeatureCmd, 21, 100);
        lastCmdTick = HAL_GetTick();
    }

    // --- 任務 B：雙重防線數據接收解算 (中斷 or 實體低電平) ---
    if (bno_data_ready || HAL_GPIO_ReadPin(GPIOE, GPIO_PIN_11) == GPIO_PIN_RESET)
    {
        bno_data_ready = 0; // 清除外部中斷標記
        uint8_t header[4];

        // 1. 讀取 SHTP 標頭 (4 Bytes)
        if (HAL_I2C_Master_Receive(&hi2c4, BNO08x_ADDR, header, 4, 100) == HAL_OK)
        {
            uint16_t length = ((header[1] << 8) | header[0]) & 0x7FFF;
            uint8_t channel = header[2];

            if (length > 4 && length <= 512)
            {
                uint8_t shtpData[512];
                // 2. 完整讀取整個封包長度
                if (HAL_I2C_Master_Receive(&hi2c4, BNO08x_ADDR, shtpData, length, 100) == HAL_OK)
                {
                    // 3. 解析通道 3 (Sensor Reports) 且 Sensor Report ID 為 0x05 (Rotation Vector)
                    if (channel == 3 && shtpData[9] == 0x05)
                    {
                        isStreaming = 1; // 解鎖，已成功建立串流連線

                        // 4. 解析 16 位元原始四元數 (Little-Endian 拼接)
                        int16_t i_raw = (shtpData[14] << 8) | shtpData[13];
                        int16_t j_raw = (shtpData[16] << 8) | shtpData[15];
                        int16_t k_raw = (shtpData[18] << 8) | shtpData[17];
                        int16_t r_raw = (shtpData[20] << 8) | shtpData[19];

                        // 5. 進行數值縮放 (14-bit Q-point = 2^14 = 16384.0f)
                        float qI = (float)i_raw / 16384.0f;
                        float qJ = (float)j_raw / 16384.0f;
                        float qK = (float)k_raw / 16384.0f;
                        float qR = (float)r_raw / 16384.0f;

                        // 6. 計算三角函數中間項
                        float sqI = qI * qI;
                        float sqJ = qJ * qJ;
                        float sqK = qK * qK;

                        // 7. 高精度四元數轉換為歐拉角 (Roll, Pitch, Yaw)
                        roll  = atan2f(2.0f * (qR * qI + qJ * qK), 1.0f - 2.0f * (sqI + sqJ)) * (180.0f / (float)M_PI);
                        pitch = asinf(2.0f * (qR * qJ - qK * qI)) * (180.0f / (float)M_PI);
                        yaw   = atan2f(2.0f * (qR * qK + qI * qJ), 1.0f - 2.0f * (sqJ + sqK)) * (180.0f / (float)M_PI);

                        // 8. 格式化列印姿態歐拉角至終端機
                        printf("姿態角度 -> Roll: %6.1f | Pitch: %6.1f | Yaw: %6.1f\r\n", roll, pitch, yaw);
                    }
                }
            }
        }
    }
  }
  /* USER CODE END 3 */
}

