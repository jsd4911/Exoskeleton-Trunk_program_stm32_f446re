uint8_t motor_mode = 0;
uint8_t is_calibrated = 0; // 狀態標籤：0 代表還沒紀錄站立點，1 代表已紀錄
// 儲存馬達即時狀態的變數
float motor_pos = 0.0f;    // 即時位置
float motor_vel = 0.0f;    // 即時速度
float motor_tor = 0.0f;    // 即時扭矩
float current_error = 0.0f;//誤差
static float error_sum = 0.0f;//誤差積分
volatile float cc = 0.0f;//誤差因子

// 按下按鈕瞬間要鎖定的「目標位置」
float target_pos = 0.0f;

