// 🛠️ BNO085 硬體自我診斷函數 (上電時呼叫)
void Check_BNO085_Hardware(void) {
    printf("\r\n=================================\r\n");
    printf("   BNO085 硬體狀態自我診斷 (N6)\r\n");
    printf("=================================\r\n");

    // 1. 檢查 INT 中斷腳位 (假設接在 GPIOB PB0)
    GPIO_PinState int_state = HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_0);
    printf("[INT 腳位] 狀態: %d (%s)\r\n",
           int_state,
           int_state == GPIO_PIN_SET ? "高電位/閒置" : "低電位/資料就緒");

    // 2. 檢查 RST 重置腳位 (假設接在 GPIOB PB1)
    GPIO_PinState rst_state = HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_1);
    printf("[RST 腳位] 狀態: %d (%s)\r\n",
           rst_state,
           rst_state == GPIO_PIN_SET ? "高電位/正常" : "低電位/重置中");

    // 3. 測試 I2C 線路與晶片存活 (Ping BNO085 地址 0x4B)
    printf("[電源連線] 嘗試透過 I2C1 探索 BNO085... \r\n");
    HAL_StatusTypeDef i2c_status = HAL_I2C_IsDeviceReady(&hi2c1, BNO08x_ADDR, 3, 100);

    if (i2c_status == HAL_OK) {
        printf("  ✅ 成功！VCC 電源正常，I2C 總線通訊正常。\r\n");
        bno085_hardware_ok = 1;
    } else {
        printf("  ❌ 失敗！找不到感測器晶片。\r\n");
        printf("  👉 警告: 系統將自動進入【模擬調試模式】，輸出模擬正弦波角度！\r\n");
        bno085_hardware_ok = 0;
    }
    printf("=================================\r\n\r\n");
}

// 🌟 讀取 BNO085 角度
float Read_BNO085_Pitch(void) {
    if (bno085_hardware_ok == 0) {
        // 模擬模式：產生 0 到 60 度的正弦波，幫助您在桌上無感測器時，安全測試馬達運轉
        static float sim_time = 0.0f;
        sim_time += 0.02f; // 每 20ms 增加一步
        float simulated_pitch = 30.0f + 30.0f * sinf(sim_time);
        return simulated_pitch;
    }

    // 實體模式：讀取 BNO085 封包
    // 這裡可以直接調用您原本大腦板運作正常的 BNO085 讀取框架
    uint8_t buffer[20];
    if (HAL_I2C_Master_Receive(&hi2c1, BNO08x_ADDR, buffer, 20, 10) == HAL_OK) {
        // 解析四元數並轉換為 Pitch (與您原本的解碼邏輯相同)
        // ...
        // 暫時回傳一個安全角度，確保編譯順利
        return 0.0f;
    }
    return 0.0f;
}
