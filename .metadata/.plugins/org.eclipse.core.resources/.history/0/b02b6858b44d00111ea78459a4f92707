float out_bend_buf[4];   // Label 2: 前彎腰 (0站, 1彎下, 2彎起, 3撐住)
float out_face_buf[3];   // Label 3: 面向 (0前, 1左, 2右)
float out_speed_buf[3];  // Label 4: 速度 (0慢, 1中, 2快)

// --- 資料預處理緩衝區 ---
uint8_t window_index = 0;
float temp_pitch[10], temp_dpitch[10];
float temp_roll[10],  temp_droll[10];
float temp_yaw[10],   temp_dyaw[10];

float last_pitch=0.0f, last_roll=0.0f, last_yaw=0.0f;
float dp_buf[10]={0}, dr_buf[10]={0}, dy_buf[10]={0};
uint8_t d_idx = 0;

uint8_t is_calibrated = 0;
float offset_pitch = 0.0f, offset_roll = 0.0f, offset_yaw = 0.0f;
