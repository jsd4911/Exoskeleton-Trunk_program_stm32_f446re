/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_I2C4_Init();
  SystemIsolation_Config();
  /* USER CODE BEGIN 2 */

  // 剛開機稍微等一下，讓系統穩定
  HAL_Delay(1000);

  // 🚀 【終極防護：手動打通 RIF 屏障】
  // 強制將 I2C3 所屬的 PA8 與 PA9 引腳降級為 NSEC (Non-Secure, 非安全屬性)
  // 這樣無論主程式在哪個安全世界運行，都能 100% 成功對這兩根引腳進行 I2C 通訊！
  HAL_GPIO_ConfigPinAttributes(GPIOA, GPIO_PIN_8, GPIO_PIN_NSEC | GPIO_PIN_NPRIV);
  HAL_GPIO_ConfigPinAttributes(GPIOA, GPIO_PIN_9, GPIO_PIN_NSEC | GPIO_PIN_NPRIV);

  // 0. I2C3 總線防鬼影精密掃描 (已補回函數，不再報錯！)
  I2C3_Scan();
  printf("\r\n--- BNO085 I2C 掃描測試 ---\r\n");

  // 1. 【防當機神器】強制重置 BNO085 (使用 N657X0-Q 的 D8/PD12 腳位)
  HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, GPIO_PIN_RESET); // RST 拉低
  HAL_Delay(50);
  HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, GPIO_PIN_SET);   // RST 拉高 (放開)
  HAL_Delay(500);                                       // 等待感測器完全開機

  // 2. 掃描 BNO085 的兩個可能位址 (使用 N657X0-Q 的 I2C3)
  printf("正在掃描 I2C 總線...\r\n");

  if (HAL_I2C_IsDeviceReady(&hi2c3, (0x4A << 1), 5, 100) == HAL_OK) {
      printf("太棒了！SUCCESS: BNO085 found at 0x4A!\r\n");
  }
  else if (HAL_I2C_IsDeviceReady(&hi2c3, (0x4B << 1), 5, 100) == HAL_OK) {
      printf("太棒了！SUCCESS: BNO085 found at 0x4B!\r\n");
  }
  else {
      printf("錯誤：找不到感測器 (ERROR: No device detected)。請檢查接線與上拉電阻。\r\n");
  }
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
      // 掃描測試階段，迴圈留空即可
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

