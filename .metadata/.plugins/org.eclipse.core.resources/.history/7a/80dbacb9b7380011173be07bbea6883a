// 接收並解碼馬達回傳訊號的中斷函式
void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan)
{
    CAN_RxHeaderTypeDef rx_header;
    uint8_t rx_data[8];

    if (HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &rx_header, rx_data) == HAL_OK)
    {
        // 確保這是我們要的馬達 (預設 ID=1，回傳時 ID 通常在資料的首位或由 Header 決定)
        // 針對 AK10-9 的 MIT 模式回傳格式進行位元重組：
        int p_int = (rx_data[1] << 8) | rx_data[2];
        int v_int = (rx_data[3] << 4) | (rx_data[4] >> 4);
        int t_int = ((rx_data[4] & 0x0F) << 8) | rx_data[5];

        // 轉換回浮點數 (極限值：位置 ±12.5, 速度 ±50, 扭矩 ±65)
        motor_pos = ((float)p_int * 25.0f / 65535.0f) - 12.5f;
        motor_vel = ((float)v_int * 100.0f / 4095.0f) - 50.0f;
        motor_tor = ((float)t_int * 130.0f / 4095.0f) - 65.0f;
    }
}
