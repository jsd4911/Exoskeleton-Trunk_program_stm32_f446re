// 新增：儲存馬達的開機初始位置
float motorA_offset = 0.0f;
int is_motorA_offset_set = 0;

void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan)
{
    CAN_RxHeaderTypeDef RxHeader;
    uint8_t RxData[8];

    if (HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &RxHeader, RxData) == HAL_OK)
    {
        uint8_t motor_id = RxData[0];
        int p_int = (RxData[1] << 8) | RxData[2];
        float position = ((float)p_int * 25.0f / 65535.0f) - 12.5f;

        if (motor_id == 0x01) {
            // 軟體歸零：把開機收到的第一個位置當作物理 0 度
            if (is_motorA_offset_set == 0) {
                motorA_offset = position;
                is_motorA_offset_set = 1;
            }
            // 真實角度 = 讀取到的角度 - 初始角度
            motorA_actual_pos = position - motorA_offset;

        } else if (motor_id == 0x02) {
            motorB_actual_pos = position; // 如果有第二顆馬達，可以依樣畫葫蘆
        }
    }
}
