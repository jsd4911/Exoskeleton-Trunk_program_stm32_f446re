/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_CAN1_Init();
  MX_USART2_UART_Init();
  MX_USART3_UART_Init();
  /* USER CODE BEGIN 2 */

  // 1. 設定 CAN 過濾器 (必須設定才能收發)
    CAN_FilterTypeDef canfilterconfig;
    canfilterconfig.FilterActivation = CAN_FILTER_ENABLE;
    canfilterconfig.FilterBank = 0;
    canfilterconfig.FilterMode = CAN_FILTERMODE_IDMASK;
    canfilterconfig.FilterScale = CAN_FILTERSCALE_32BIT;
    canfilterconfig.FilterIdHigh = 0x0000;
    canfilterconfig.FilterIdLow = 0x0000;
    canfilterconfig.FilterMaskIdHigh = 0x0000;
    canfilterconfig.FilterMaskIdLow = 0x0000;
    canfilterconfig.FilterFIFOAssignment = CAN_RX_FIFO0;
    HAL_CAN_ConfigFilter(&hcan1, &canfilterconfig);

    // 2. 啟動 CAN 控制器
    HAL_CAN_Start(&hcan1);
    // 🌟 啟動 CAN 接收中斷 (這行非常重要，沒有它就收不到回信！)
    HAL_CAN_ActivateNotification(&hcan1, CAN_IT_RX_FIFO0_MSG_PENDING);

    // 3. 延遲一秒等待馬達通電開機
    HAL_Delay(1000);

    AK10_9_EnableMotor(&hcan1, 0x01); // 啟動馬達 A
    AK10_9_EnableMotor(&hcan1, 0x02); // 啟動馬達 B

    // 給馬達一點時間進入控制模式
    HAL_Delay(100);

    // 🚀 關鍵升級：啟動 UART DMA 背景接收
    HAL_UART_Receive_DMA(&huart3, rx_buffer, 8);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  // 「DMA 死亡復甦機制」
	      if (huart3.ErrorCode != HAL_UART_ERROR_NONE) {
	          printf("UART Error %lu Detected! Auto-Recovering...\r\n", huart3.ErrorCode);
	          HAL_UART_AbortReceive(&huart3);
	          __HAL_UART_CLEAR_OREFLAG(&huart3);
	          __HAL_UART_CLEAR_NEFLAG(&huart3);
	          __HAL_UART_CLEAR_FEFLAG(&huart3);
	          huart3.ErrorCode = HAL_UART_ERROR_NONE;
	          HAL_UART_Receive_DMA(&huart3, rx_buffer, 8);
	      }
	  // 🌟 安全升級 3：通訊斷線保護 (UART Disconnect Protection)
	        // 如果 8 個 bytes 全都是 0，代表可能還沒收到資料或杜邦線脫落，此時不更新座標
	        int is_data_valid = 0;
	        for(int i=0; i<8; i++) {
	            if(rx_buffer[i] != 0) is_data_valid = 1;
	        }

	        if (is_data_valid) {
	            // 1. 從 rx_buffer 解析出 target_X (前 4 個 Bytes)
	            data_converter.bytes[0] = rx_buffer[0];
	            data_converter.bytes[1] = rx_buffer[1];
	            data_converter.bytes[2] = rx_buffer[2];
	            data_converter.bytes[3] = rx_buffer[3];
	            target_X = data_converter.fval;

	            // 2. 從 rx_buffer 解析出 target_Y (後 4 個 Bytes)
	            data_converter.bytes[0] = rx_buffer[4];
	            data_converter.bytes[1] = rx_buffer[5];
	            data_converter.bytes[2] = rx_buffer[6];
	            data_converter.bytes[3] = rx_buffer[7];
	            target_Y = data_converter.fval;

	            // 🛑 軟體極限擋塊：限制座標在安全半徑內
	            // 假設最遠只能伸到 35cm，最近只能縮到 15cm，Y 最低不能超過 -25cm
	            if (target_X > 0.35f) target_X = 0.35f;
	            if (target_X < 0.15f) target_X = 0.15f;
	            if (target_Y > 0.10f) target_Y = 0.10f;
	            if (target_Y < -0.25f) target_Y = -0.25f;
	        }
	        // 🌟 核心修復：加入軟體低通濾波器 (Alpha = 0.01)
	        // 讓 smooth 座標慢慢追上 target 座標，防止馬達瞬間抽動
	        smooth_X = smooth_X + 0.01f * (target_X - smooth_X);
	        smooth_Y = smooth_Y + 0.01f * (target_Y - smooth_Y);

	        // 3. 執行逆向運動學 (IK) 算出馬達目標角度
		    // 🌟 把 IK 計算公式裡的 target_X/Y 全部換成 smooth_X/Y
			float cos_theta_B = (smooth_X*smooth_X + smooth_Y*smooth_Y - L1*L1 - L2*L2) / (2 * L1 * L2);

	        // 防護：確保沒有超出連桿極限
	        if(cos_theta_B > 1.0f) cos_theta_B = 1.0f;
	        if(cos_theta_B < -1.0f) cos_theta_B = -1.0f;
	        float theta_B = acosf(cos_theta_B);

	        // 計算 A 馬達 (肩膀)
	        float theta_A = atan2f(smooth_Y, smooth_X) - atan2f(L2 * sinf(theta_B), L1 + L2 * cosf(theta_B));

	        //  終極校正：反轉數學方向，迎合馬達的物理方向！ 🌟🌟🌟
	        theta_A = -theta_A;

	        // 4. 估算前饋力矩 (補償馬達 B 的 0.5kg 重力)
	        float m_B = 0.5f; // kg
	        float g = 9.81f;
	        float tau_ff_A = m_B * g * L1 * cosf(theta_A);
	        float tau_ff_B = 0.0f;

	        // 5. 送出阻抗控制指令
	        // 🌟 測試初期，強烈建議先把 Kp 降到 1.0 (非常軟的彈簧)，確保安全
	        AK10_9_SendCommand(&hcan1, 0x01, -theta_A, 0.0f, 0.5f, 0.1f, tau_ff_A);
	        AK10_9_SendCommand(&hcan1, 0x02, -theta_B, 0.0f, 0.5f, 0.1f, tau_ff_B);
	        // 馬達 A: 重力補償，低剛性 Kp=10.0 保有透明度
	        //AK10_9_SendCommand(&hcan1, 0x01, theta_A, 0.0f, 10.0f, 1.0f, tau_ff_A);
	        // 馬達 B: 依照目標角度運轉
	        //AK10_9_SendCommand(&hcan1, 0x02, theta_B, 0.0f, 10.0f, 1.0f, tau_ff_B);

	        // 迴圈延遲 (維持 1000Hz 控制頻率)
	        HAL_Delay(1);

	        // 在小腦板 union 解碼出 target_X 和 target_Y 之後加上：
	        if (is_data_valid) {
	        	float target_A_deg = theta_A * 180.0f / 3.14159f;
	        	float actual_A_deg = motorA_actual_pos * 180.0f / 3.14159f;

	        	printf("Cmd: %.1f deg | Actual: %.1f deg | motorA_actual_pos: %.1f\r\n ", target_A_deg, actual_A_deg,motorA_actual_pos);
	        }
  }
  /* USER CODE END 3 */
}

