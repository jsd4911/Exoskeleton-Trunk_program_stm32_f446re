/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C3_Init();
  MX_USART1_UART_Init();
  SystemIsolation_Config();
  /* USER CODE BEGIN 2 */
  HAL_Delay(100); // 讓周邊電源穩定
  printf("\r\n==============================================\r\n");
  printf("  STM32N657X0 BNO085 I2C 角度讀取測試程式  \r\n");
  printf("==============================================\r\n");

  // 0. 優先執行 I2C 地址驗證掃描
  I2C3_Scan();

  // 1. 執行硬體重置
  BNO085_Reset();

  // 2. 接收並排空 BNO085 開機時自動發送的廣播廣告、開機重置狀態封包
  // 這些封包（通常是 Channel 1 和 Channel 2）如果不讀取，INT 腳會一直維持在低電平，導致新中斷無法觸發
  printf("[BNO085] 正在清空開機廣播封包...\r\n");
  uint8_t rx_buf[128];
  uint16_t bytes_read = 0;
  for (int i = 0; i < 5; i++) {
      if (BNO085_ReadPacket(rx_buf, sizeof(rx_buf), &bytes_read) == HAL_OK) {
          printf("[BNO085] 已清除開機封包 - 長度: %d 頻道: %d\r\n", bytes_read, rx_buf[2]);
      } else {
          break; // 沒有更多立即封包，退出清除
      }
      HAL_Delay(10);
  }

  // 3. 發送訂閱 100Hz Rotation Vector (四元數) 請求
  BNO085_EnableRotationVector();
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    // 當中斷觸發（PE11 拉低），bno_data_ready 會被置 1
    if (bno_data_ready) {
        uint8_t rx_buffer[128];
        uint16_t read_len = 0;

        // 讀取 SHTP 資料包
        if (BNO085_ReadPacket(rx_buffer, sizeof(rx_buffer), &read_len) == HAL_OK) {
            // 頻道 3 代表 Sensor Reports 數據
            if (rx_buffer[2] == 3) {
                ParseRotationVector(rx_buffer, read_len);
            }
        } else {
            bno_data_ready = 0; // 防呆超時清除
        }
    }
  }
  /* USER CODE END 3 */
}

