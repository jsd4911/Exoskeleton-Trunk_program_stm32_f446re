// 優先確認 I2C 裝置地址掃描函數
void I2C3_Scan(void) {
    printf("[I2C3] 開始掃描總線裝置...\r\n");
    uint8_t devices_found = 0;

    for (uint16_t i = 1; i < 128; i++) {
        // HAL_I2C_IsDeviceReady 傳入的地址必須是 8 位元格式 (7位元左移1位)
        if (HAL_I2C_IsDeviceReady(&hi2c3, (i << 1), 3, 10) == HAL_OK) {
            printf("  -> 發現裝置！ 7位元位址: 0x%02X (寫入位址: 0x%02X)", i, (i << 1));
            if (i == 0x4A) {
                printf(" [BNO085 預設地址]");
            } else if (i == 0x4B) {
                printf(" [BNO085 備用地址 (AD0拉高)]");
            }
            printf("\r\n");
            devices_found++;
        }
    }

    if (devices_found == 0) {
        printf("[I2C3] 警告: 未在總線上發現任何裝置。請檢查 SDA(PA9)/SCL(PA8) 的實體接線與 4.7k 上拉電阻！\r\n");
    } else {
        printf("[I2C3] 掃描完畢，共發現 %d 個活躍裝置。\r\n", devices_found);
    }
    printf("==============================================\r\n");
}

// 1. 硬體重置 BNO085 函數 (使用正面 D8 -> PD12，低電平有效)
void BNO085_Reset(void) {
    printf("[BNO085] 正在執行硬體重置...\r\n");
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, GPIO_PIN_RESET); // 拉低 RST 腳
    HAL_Delay(50);                                         // 持續 50ms
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, GPIO_PIN_SET);   // 拉高 RST 解除重置
    HAL_Delay(150);                                        // 等待 BNO085 開機引導與初始化
    printf("[BNO085] 硬體重置完成。\r\n");
}

// 2. 發送 SHTP 數據包
HAL_StatusTypeDef BNO085_WritePacket(uint8_t *data, uint16_t len) {
    return HAL_I2C_Master_Transmit(&hi2c3, BNO085_I2C_ADDR, data, len, 100);
}

// 3. 讀取 SHTP 數據包 (中斷觸發後調用)
HAL_StatusTypeDef BNO085_ReadPacket(uint8_t *buffer, uint16_t max_len, uint16_t *bytes_read) {
    uint8_t header[4];
    HAL_StatusTypeDef status;

    // 如果沒有中斷訊號，進行超時保護等待（約500ms）
    uint32_t tickstart = HAL_GetTick();
    while (bno_data_ready == 0) {
        if ((HAL_GetTick() - tickstart) > 500) {
            return HAL_TIMEOUT;
        }
    }
    bno_data_ready = 0; // 清除中斷旗標

    // 先讀取 4 位元組 SHTP 標頭
    status = HAL_I2C_Master_Receive(&hi2c3, BNO085_I2C_ADDR, header, 4, 100);
    if (status != HAL_OK) return status;

    // 解析資料包總長度 (LSB, MSB)
    uint16_t len = ((header[1] & 0x7F) << 8) | header[0];
    if (len == 0) {
        *bytes_read = 0;
        return HAL_OK;
    }

    if (len > max_len) {
        return HAL_ERROR; // 避免緩衝區溢出
    }

    // 複製標頭到用戶 buffer
    memcpy(buffer, header, 4);

    // 接收賸餘的 payload 數據
    status = HAL_I2C_Master_Receive(&hi2c3, BNO085_I2C_ADDR, buffer + 4, len - 4, 200);
    if (status != HAL_OK) return status;

    *bytes_read = len;
    return HAL_OK;
}

// 4. 啟用旋轉向量訂閱 (100Hz)
void BNO085_EnableRotationVector(void) {
    // SHTP 協議的「Set Feature (0xFD)」控制封包 (總長度 21 bytes)
    uint8_t cmd[21] = {
        21, 0,           // SHTP 標頭長度 (LSB, MSB)
        2,               // 頻道 2 (Control Channel)
        0,               // 序列號 (自動計數，起始為 0)
        0xFD,            // Report ID: Set Feature Command
        0x05,            // Feature Report ID: 0x05 代表 Rotation Vector (四元數姿態)
        0,               // Change flags
        0, 0,            // Change sensitivity
        0x10, 0x27, 0, 0,// 上報週期：10,000 微秒 = 100 Hz (LSB to MSB)
        0, 0, 0, 0,      // 感測器特定配置 (通常為 0)
        0, 0, 0, 0       // 保留欄位
    };

    printf("[BNO085] 正在發送 Rotation Vector (四元數) 訂閱指令...\r\n");
    if (BNO085_WritePacket(cmd, 21) == HAL_OK) {
        printf("[BNO085] 訂閱指令發送成功！\r\n");
    } else {
        printf("[BNO085] 錯誤: 訂閱指令發送失敗，請確認上拉電阻與接線。\r\n");
    }
}

// 5. 四元數 轉換 歐拉角 (Roll, Pitch, Yaw)
EulerAngles_t QuaternionToEuler(double qw, double qx, double qy, double qz) {
    EulerAngles_t angles;

    // Roll (x-axis rotation)
    double sinr_cosp = 2.0 * (qw * qx + qy * qz);
    double cosr_cosp = 1.0 - 2.0 * (qx * qx + qy * qy);
    angles.roll = atan2(sinr_cosp, cosr_cosp);

    // Pitch (y-axis rotation)
    double sinp = 2.0 * (qw * qy - qz * qx);
    if (fabs(sinp) >= 1.0)
        angles.pitch = copysign(M_PI / 2.0, sinp); // 避免溢出
    else
        angles.pitch = asin(sinp);

    // Yaw (z-axis rotation)
    double siny_cosp = 2.0 * (qw * qz + qx * qy);
    double cosy_cosp = 1.0 - 2.0 * (qy * qy + qz * qz);
    angles.yaw = atan2(siny_cosp, cosy_cosp);

    // 弧度轉角度
    angles.roll  = angles.roll  * 180.0 / M_PI;
    angles.pitch = angles.pitch * 180.0 / M_PI;
    angles.yaw   = angles.yaw   * 180.0 / M_PI;

    // 將 Yaw 限制在 0 ~ 360 度範圍
    if (angles.yaw < 0) {
        angles.yaw += 360.0;
    }

    return angles;
}

// 6. 動態搜尋並解析 I2C 封包中的角度數據
void ParseRotationVector(uint8_t *payload, uint16_t len) {
    // 遍歷 Channel 3 的資料包，尋找 Rotation Vector Report ID (0x05)
    for (int i = 4; i < len; i++) {
        if (payload[i] == 0x05) { // 找到 Rotation Vector
            if (i + 11 < len) {
                // 解析 16-bit 原始四元數 (小端格式)
                int16_t raw_qx = (payload[i+5] << 8) | payload[i+4];
                int16_t raw_qy = (payload[i+7] << 8) | payload[i+6];
                int16_t raw_qz = (payload[i+9] << 8) | payload[i+8];
                int16_t raw_qw = (payload[i+11] << 8) | payload[i+10];

                // 根據 BNO085 規範，Rotation Vector 的 Q 因子為 14 (除以 2^14 = 16384)
                double qx = (double)raw_qx / 16384.0;
                double qy = (double)raw_qy / 16384.0;
                double qz = (double)raw_qz / 16384.0;
                double qw = (double)raw_qw / 16384.0;

                // 轉換歐拉角
                EulerAngles_t rpy = QuaternionToEuler(qw, qx, qy, qz);

                // 打印格式化歐拉角到序列埠
                printf("姿態角度 -> Roll: %6.2f | Pitch: %6.2f | Yaw: %6.2f\r\n", rpy.roll, rpy.pitch, rpy.yaw);
            }
            break;
        }
    }
}
