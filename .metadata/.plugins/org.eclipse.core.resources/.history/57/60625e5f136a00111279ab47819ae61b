/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_CAN1_Init();
  MX_USART2_UART_Init();
  MX_USART3_UART_Init();
  MX_CAN2_Init();
  /* USER CODE BEGIN 2 */

    //向編譯器宣告這個結構體
    CAN_FilterTypeDef sFilterConfig;
    sFilterConfig.FilterBank = 0;
    sFilterConfig.FilterMode = CAN_FILTERMODE_IDMASK;
    sFilterConfig.FilterScale = CAN_FILTERSCALE_32BIT;
    sFilterConfig.FilterIdHigh = 0x0000;
    sFilterConfig.FilterIdLow = 0x0000;
    sFilterConfig.FilterMaskIdHigh = 0x0000;
    sFilterConfig.FilterMaskIdLow = 0x0000;
    sFilterConfig.FilterFIFOAssignment = CAN_RX_FIFO0;
    sFilterConfig.FilterActivation = ENABLE;
    sFilterConfig.SlaveStartFilterBank = 14; // 非常重要：告訴系統 14 號以後是給 CAN2 用的

    HAL_CAN_ConfigFilter(&hcan1, &sFilterConfig);
    HAL_CAN_Start(&hcan1);
    HAL_CAN_ActivateNotification(&hcan1, CAN_IT_RX_FIFO0_MSG_PENDING);

    // --- 設定 CAN2 過濾器 (給 B 馬達) ---
    sFilterConfig.FilterBank = 14; // CAN2 從 14 號開始
    HAL_CAN_ConfigFilter(&hcan2, &sFilterConfig);
    HAL_CAN_Start(&hcan2);
    HAL_CAN_ActivateNotification(&hcan2, CAN_IT_RX_FIFO0_MSG_PENDING);

    AK10_9_EnableMotor(&hcan1, 0x01);
    HAL_Delay(10);  // 給馬達晶片 10 毫秒的反應時間，避免指令擠在一起
    AK10_9_EnableMotor(&hcan2, 0x01);
    HAL_Delay(10);

    // 給馬達一點時間進入控制模式
    HAL_Delay(100);

    // 🚀 關鍵升級：啟動 UART DMA 背景接收
    HAL_UART_Receive_DMA(&huart3, rx_buffer, 13);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  	  // 🌟 加上這三行「心肺復甦術」：只要 UART 閒置罷工，就立刻強制它重新接收 13 Bytes！
	        	if (huart3.RxState == HAL_UART_STATE_READY) {
	        		HAL_UART_Receive_DMA(&huart3, rx_buffer, 13);
	        	}


	            if (huart3.ErrorCode != HAL_UART_ERROR_NONE) {
	                HAL_UART_AbortReceive(&huart3);
	                __HAL_UART_CLEAR_OREFLAG(&huart3);
	                __HAL_UART_CLEAR_NEFLAG(&huart3);
	                __HAL_UART_CLEAR_FEFLAG(&huart3);
	                huart3.ErrorCode = HAL_UART_ERROR_NONE;
	                HAL_UART_Receive_DMA(&huart3, rx_buffer, 13); // 這裡也要改成 13
	            }

	            int header_idx = -1;
	            // 🌟 環形掃描器：尋找 13 Bytes 封包的開頭與結尾
	            // 無論 DMA 從哪裡開始切斷，我們都一定能找出完美的封包
	            for(int i=0; i<13; i++) {
	                if(rx_buffer[i] == 0xAA &&
	                   rx_buffer[(i+1)%13] == 0x55 &&
	                   rx_buffer[(i+11)%13] == 0x0D &&
	                   rx_buffer[(i+12)%13] == 0x0A) {
	                    header_idx = i;
	                    break;
	                }
	            }

	            timeout_counter++;
	            if (timeout_counter > 50) { // 50ms 沒收到完整封包，視為斷線
	            	is_brain_ready = 0;
	            }

	            static int is_brain_ready = 0;
	            static int timeout_counter = 0;

	            if (header_idx != -1) {
	                // 抽出第 3 個 Byte (狀態碼)
	                uint8_t status = rx_buffer[(header_idx + 2) % 13];

	                // 完美還原 X 與 Y 的浮點數
	                data_converter.bytes[0] = rx_buffer[(header_idx + 3) % 13];
	                data_converter.bytes[1] = rx_buffer[(header_idx + 4) % 13];
	                data_converter.bytes[2] = rx_buffer[(header_idx + 5) % 13];
	                data_converter.bytes[3] = rx_buffer[(header_idx + 6) % 13];
	                float temp_X = data_converter.fval;

	                data_converter.bytes[0] = rx_buffer[(header_idx + 7) % 13];
	                data_converter.bytes[1] = rx_buffer[(header_idx + 8) % 13];
	                data_converter.bytes[2] = rx_buffer[(header_idx + 9) % 13];
	                data_converter.bytes[3] = rx_buffer[(header_idx + 10) % 13];
	                float temp_Y = data_converter.fval;

	                // 只有大腦說「我準備好了」，才允許更新座標
	                if (status == 1) {
	                    if (temp_X <= 0.4f && temp_X >= 0.0f && temp_Y <= 0.2f && temp_Y >= -0.4f) {
	                        target_X = temp_X;
	                        target_Y = temp_Y;
	                        is_brain_ready = 1;
	                        timeout_counter = 0;
	                    }
	                } else {
	                    is_brain_ready = 0; // 大腦還在暖機中
	                }
	            } else {
	                timeout_counter++;
	                if (timeout_counter > 50) { // 50ms 沒收到完整封包，視為斷線
	                    is_brain_ready = 0;
	                }
	            }

	            // 🛡️ 終極防護罩機制 (動態同步)
	            if (!is_brain_ready) {
	                current_Kp = 0.0f;          // 解除剛性，馬達完全放鬆自由
	                // 🌟 安全升級：使用正向運動學讓虛擬座標追蹤真實物理位置
	                // 確保在大腦連線的瞬間，目標座標與實體位置 100% 重合，實現零暴衝！
	                float actual_theta_A = motorA_actual_pos;
	                float actual_theta_B = motorB_actual_pos;
	                smooth_X = L1 * cosf(actual_theta_A) + L2 * cosf(actual_theta_A + actual_theta_B);
	                smooth_Y = L1 * sinf(actual_theta_A) + L2 * sinf(actual_theta_A + actual_theta_B);\

	                target_X = smooth_X;        // 目標鎖定在馬達「當下」的平滑位置
	                target_Y = smooth_Y;        // 確保連線瞬間，距離差為 0，絕對不會暴衝！
	            } else {
	                if (current_Kp < MAX_Kp) {
	                    current_Kp += 0.005f;   // 緩慢增加剛性，實現幽靈般的平滑接合
	                }
	            }

	            // 🛡️ 速度極限器 (每毫秒最多 2mm)
	            float max_speed = 0.002f;
	            float diff_X = target_X - smooth_X;
	            if (diff_X > max_speed) diff_X = max_speed;
	            if (diff_X < -max_speed) diff_X = -max_speed;
	            smooth_X += diff_X;

	            float diff_Y = target_Y - smooth_Y;
	            if (diff_Y > max_speed) diff_Y = max_speed;
	            if (diff_Y < -max_speed) diff_Y = -max_speed;
	            smooth_Y += diff_Y;

	            // 逆向運動學
	            float cos_theta_B = (smooth_X*smooth_X + smooth_Y*smooth_Y - L1*L1 - L2*L2) / (2 * L1 * L2);
	            if(cos_theta_B > 1.0f) cos_theta_B = 1.0f;
	            if(cos_theta_B < -1.0f) cos_theta_B = -1.0f;
	            float theta_B = acosf(cos_theta_B);
	            float theta_A = atan2f(smooth_Y, smooth_X) - atan2f(L2 * sinf(theta_B), L1 + L2 * cosf(theta_B));

	            // 方向反轉
	            //theta_A = -theta_A;

	            float motor_cmd_A = theta_A + motorA_offset;
	            //float motor_cmd_B = -theta_B + motorB_offset;
	            // 改成這行 (拿掉負號，讓它跟實體方向一致！)
	            float motor_cmd_B = theta_B + motorB_offset;

	            // 🌟 新增：重力補償前饋力矩 (Feedforward Torque)
	            // 這裡用最簡單的單擺重力模型來估算，當手臂水平 (theta_A = 0) 時力矩最大
	            float tau_ff_A = m_B * g * L1 * cosf(theta_A);
	            float tau_ff_B = 0.0f; // 如果 B 馬達末端沒有掛重物，可以設為 0

	            // 🛡️ 終極防護：大腦沒準備好前，徹底沒收所有出力！
	            if (!is_brain_ready) {
	                tau_ff_A = 0.0f;
	                tau_ff_B = 0.0f;
	            }

	            // 對 CAN1 發送 (控制 A 馬達)
	            AK10_9_SendCommand(&hcan1, 0x01, motor_cmd_A, 0.0f, current_Kp, 0.1f, tau_ff_A);
	            // 對 CAN2 發送 (控制 B 馬達)
	            AK10_9_SendCommand(&hcan2, 0x01, motor_cmd_B, 0.0f, current_Kp, 0.1f, tau_ff_B);

	            HAL_Delay(1);

	            // 🌟 降低列印頻率，每 50ms 印一次，避免塞爆 UART 通訊
	            static int print_counter = 0;
	            print_counter++;
	            if (print_counter >= 50) {
	                if (is_brain_ready) {
	                    float target_A_deg = theta_A * 180.0f / 3.14159f;
	                    float actual_A_deg = motorA_actual_pos * 180.0f / 3.14159f;
	                    printf("✅ 連線中 | Cmd: %.1f deg | Actual: %.1f deg | Kp: %.2f\r\n", target_A_deg, actual_A_deg, current_Kp);
	                } else {
	                    printf("⏳ 等待大腦暖機或斷線... Kp: %.2f\r\n", current_Kp);
	                }
	                print_counter = 0;
	            }
	          }
  /* USER CODE END 3 */
}

